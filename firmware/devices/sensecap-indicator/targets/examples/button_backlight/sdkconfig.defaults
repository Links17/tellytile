# SenseCAP Indicator (D1/D1S/D1Pro/D1L): 8 MB flash, 8 MB octal PSRAM.
# Field-verified memory config: the imported hardware reference
# esp32/devices/sdkconfig.sensecap-indicator (Apache 2.0) — QIO flash @80 MHz,
# octal PSRAM @80 MHz. (Vendor SenseCAP_Indicator_ESP32 runs 120 MHz with an
# IDF 5.x patch; 80 MHz is the conservative, field-tested option.)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Keep the external memory cache available during NVS writes for RGB scanout.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# The original pairing client validates HTTPS with ESP-IDF's certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
